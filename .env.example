ODDSPAPI_KEY=replace-me
# Postgres for fixtures/odds. Compose builds odds-service's DATABASE_URL from these;
# DATABASE_URL here is for running scripts from the host (published on 127.0.0.1:5433).
POSTGRES_USER=odds
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=odds
DATABASE_URL=postgresql://odds:replace-me@127.0.0.1:5433/odds
# From @BotFather. Default chat is optional; requests can pass chat_id instead.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_DEFAULT_CHAT_ID=
